# Pinned inputs for the production image build. Edit this file in a pull request
# to change what goes into the image. GitHub Actions builds with Docker BuildKit
# on its runner and pushes to Artifact Registry using the builder's WIF token.
# A human can `source` this file for the manual build in docs/DEPLOYMENT.md.
# Do not build on the production VM while it serves traffic.
#
# Every ref is a tag or a full commit SHA, never a moving branch, so the same
# commit always builds the same image.

# frappe/frappe_docker commit (provides images/layered/Containerfile).
FRAPPE_DOCKER_SHA=2b26e9ab8d751e5ea33bb7b930aea3550bb81ded

# Frappe tag. It also selects the frappe/build and frappe/base images, so it
# must be a tag that exists in Docker Hub for both.
FRAPPE_REF=v16.36.1

# Other apps (git tags). HRMS comes from this repository at the exact commit
# being built; the workflow creates the tag build-<sha12> for it.
ERPNEXT_REF=v16.37.0
CRM_REF=v1.86.0

# Image tag prefix. The full tag is <prefix>-<first 12 characters of the commit SHA>.
IMAGE_TAG_PREFIX=v16
